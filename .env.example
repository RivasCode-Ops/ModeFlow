# Copie para .env.local e preencha (nunca commite .env.local)
#
# Supabase: Project Settings → API (URL + anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostgreSQL: Project Settings → Database → Connection string (URI)
# Se a senha tiver @ ! # etc., use a string pronta do painel OU codifique a senha (ex.: @ → %40)
DATABASE_URL=

# Opcional
OPENAI_API_KEY=
